FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for WeasyPrint, OpenCV, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz-subset0 \
    libffi-dev \
    libjpeg-dev \
    libpng-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
# constraints.txt pins every package to versions validated on the reference host.
# POLICY: regenerate constraints.txt whenever requirements*.txt changes (see its header).
ENV PIP_DEFAULT_TIMEOUT=100 \
    PIP_RETRIES=10
COPY requirements.txt constraints.txt ./
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt -c constraints.txt

# Copy application code
COPY src/backend/ ./

# Create required directories
RUN mkdir -p uploads results derivatives peritus_cases

EXPOSE 8000

# Production: no --reload, single worker bound to all interfaces
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
