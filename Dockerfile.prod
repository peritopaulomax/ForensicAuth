FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for WeasyPrint, OpenCV, etc.
# g++ is required to compile jpegio's bundled libjpeg (Cython extension).
# libgl1 is required by opencv-python (pulled in by mmengine).
# libwebp7/libzstd1/liblzma5/libjbig0/libdeflate0 are libtiff.so.5 deps (libzero).
# libimage-exiftool-perl provides the exiftool binary used by PyExifTool.
# graphviz provides the `dot` binary used by pydot for PDF structure graphs.
# ffmpeg provides ffprobe/ffmpeg for deep video/audio metadata and decoding.
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    libgl1 \
    libwebp7 \
    libzstd1 \
    liblzma5 \
    libjbig0 \
    libdeflate0 \
    libimage-exiftool-perl \
    graphviz \
    ffmpeg \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz-subset0 \
    libffi-dev \
    libjpeg-dev \
    libpng-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
# constraints.txt pins every package to versions validated on the reference host.
# POLICY: regenerate constraints.txt whenever requirements*.txt changes (see its header).
ENV PIP_DEFAULT_TIMEOUT=100 \
    PIP_RETRIES=10 \
    LD_LIBRARY_PATH=/app/src/backend/lib/native
COPY requirements.txt constraints.txt ./
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt -c constraints.txt

# Copy application code mirroring the repo layout (/app/src/backend) so that
# repo-root-relative paths (config.py parents[3], alembic.ini, forensics/paths.py)
# resolve to /app inside the container. vendor/ is bind-mounted by compose.
COPY src/backend/ /app/src/backend/
COPY alembic.ini /app/alembic.ini
COPY alembic/ /app/alembic/

# Create required directories
RUN mkdir -p /app/uploads /app/results /app/derivatives /app/peritus_cases \
    && mkdir -p /opt/forensicauth/data/uploads \
    && mkdir -p /opt/forensicauth/data/results \
    && mkdir -p /opt/forensicauth/data/derivatives \
    && mkdir -p /opt/forensicauth/data/peritus_cases \
    && mkdir -p /opt/forensicauth/models \
    && mkdir -p /opt/forensicauth/reference_data \
    && mkdir -p /opt/forensicauth/vendor \
    && chown -R 1000:1000 /opt/forensicauth

WORKDIR /app/src/backend

EXPOSE 8000

# Production: no --reload, single worker bound to all interfaces
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
