# ForensicAuth Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production-forensicauth-2026

# JWT access curto + refresh opaco longo (hash no DB)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Security (required in production)
# Generate a strong SECRET_KEY, e.g.: openssl rand -hex 32
# Ed25519 custody keys (base64 raw). Dev auto-generates under data/.data/ if empty.
# Production one-liner (conda forensicauth + cryptography):
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; import base64; k=Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes(serialization.Encoding.Raw, serialization.PrivateFormat.Raw, serialization.NoEncryption())).decode()); print(base64.b64encode(k.public_key().public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)).decode())"
CUSTODY_SIGNING_PRIVATE_KEY=
CUSTODY_SIGNING_PUBLIC_KEY=

# Database (dev SQLite sob data/db; prod PostgreSQL)
DATABASE_URL=sqlite:///./data/db/vasuite_dev.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/forensicauth

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage (dev: sob data/; paths relativos = raiz do repo)
UPLOAD_DIR=./data/uploads
RESULTS_DIR=./data/results
DERIVATIVES_DIR=./data/derivatives
PERITUS_CASES_DIR=./data/peritus_cases
MODELS_DIR=./models
# LR / tipicidade — três roots (publish / build / bases)
REFERENCE_DATA_DIR=./reference_data
FORENSICAUTH_REFERENCE_DATA_DIR=./reference_data
# Staging pesado (samples + augmented) — fora do git (default: ../va-reference_build)
# REFERENCE_BUILD_DIR=/home/voce/va-reference_build
# FORENSICAUTH_REFERENCE_BUILD_DIR=/home/voce/va-reference_build
# Corpora imutáveis
BASES_ROOT=/mnt/bases
FORENSICAUTH_BASES_ROOT=/mnt/bases
JOB_PREVIEW_RETENTION_DAYS=0
# 0 = previews elegiveis a remocao imediata no sweep diario (artefatos nao promovidos a derivados).
# Use 7–30 em ambientes onde peritos reabrem jobs recentes com frequencia.
JOB_PREVIEW_DAILY_CLEANUP=true
JOB_PREVIEW_CLEANUP_HOUR=2
# Limpeza roda no processo API: passagem na subida + todos os dias na hora local acima.
# Remove RESULTS_DIR/{case}/{evidence}/{job}/ (e layout legado RESULTS_DIR/{job}/).

# Assinaturas PDF (pdfsig_forense) — raiz oficial ICP-Brasil (ITI) recomendada
# PDF_SIG_TRUST_ANCHORS=/caminho/raiz-icpbrasil-v5.crt
PDF_SIG_TRUST_ANCHOR_DIR=./models/icpbrasil
PDF_SIG_TZ_OFFSET=-3
PDF_SIG_FETCH=false
PDF_SIG_REDACT=true

HF_HUB_CACHE=./models/synthetic_image_detection/huggingface
TRANSFORMERS_OFFLINE=1

# GPU
GPU_AVAILABLE=false

# C2PA / Content Credentials (opcional): PEM de âncoras de confiança
# C2PA_TRUST_ANCHORS_PATH=/path/to/anchors.pem

# Paralelismo interno (joblib por job — não exposto na UI)
# Regra prática: nucleos ≈ (jobs Celery simultâneos) × N_JOBS + ~8 reserva (API/DB/SO)
# Ex.: worker -c 4 + JPEG_GHOSTS_N_JOBS=6 → até ~24 núcleos em Ghosts pesados
JPEG_GHOSTS_N_JOBS=6
PRNU_LOCALIZED_N_JOBS=4
# Copy-Move PCA: Numba + OpenCV + OpenBLAS (0 = auto, todos os nucleos)
COPY_MOVE_PCA_N_JOBS=0
